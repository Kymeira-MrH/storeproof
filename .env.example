# Supabase (accounts, scans, subscriptions, evidence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (self-serve billing) — Stage 2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify OAuth app (alt-text write-back) — Stage 3
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Serverless Chromium (set on Vercel at deploy via @sparticuz/chromium); leave blank locally
PLAYWRIGHT_EXECUTABLE_PATH=

# Rate limiter (Upstash Redis) — scan endpoint abuse protection. Without these it
# falls back to an in-memory per-instance limiter (fine locally, not for prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email (Resend, free tier). Without RESEND_API_KEY, emailing is a no-op
# (scan still works; the UI just won't claim a copy was emailed).
RESEND_API_KEY=
EMAIL_FROM=StoreProof <reports@storeproof.co.uk>
EMAIL_REPLY_TO=info@vpnetworks.co.uk
EMAIL_NOTIFY=info@vpnetworks.co.uk
